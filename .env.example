# Variables de entorno para Luna - Asistente de ciclo menstrual
# Copia este archivo como .env y completa los valores

PORT=3000

# PostgreSQL - formato: postgresql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/luna_db

# JWT - clave secreta segura (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_una_clave_muy_segura_de_al_menos_32_caracteres

# JWT expiración (7d = 7 días)
JWT_EXPIRES_IN=7d




# Bcrypt rounds (10-12 recomendado)
BCRYPT_ROUNDS=12

# Entorno
NODE_ENV=development

# DeepSeek API - obtén tu clave en https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo recomendado: deepseek-chat (DeepSeek-V3)
DEEPSEEK_MODEL=deepseek-chat
